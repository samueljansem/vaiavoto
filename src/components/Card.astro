---
import type { Proposta } from '../lib/site';
import { podeAgir, primeiraFrase, textoWhatsApp, urlProposta } from '../lib/site';
import Chip from './Chip.astro';
import Placar from './Placar.astro';

interface Props { p: Proposta; posicao?: number; votosPeriodo?: string | null }
const { p, posicao, votosPeriodo } = Astro.props;
// Quando a Casa publicou uma explicação, o card mostra a primeira frase dela; senão, a situação ("E agora?").
const frase = p.explicacao ? primeiraFrase(p.explicacao.texto) : p.agora;
---
<article class="cartao">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    {posicao && <span class="posicao">{posicao}º</span>}
    <Chip p={p} />
  </div>
  <a class="card-titulo limite-3" href={urlProposta(p)}>{p.titulo}</a>
  <p class="card-texto limite-3">{frase}</p>
  {p.enquete && p.enquete.total >= 50 && <Placar enquete={p.enquete} casa={p.casa} votosPeriodo={votosPeriodo} />}
  {p.enquete && p.enquete.total < 50 && p.enquete.participavel && (
    <div class="placar">
      <span class="aberta">Enquete aberta</span>
      <span style="font-size:15px">Poucas pessoas opinaram até agora ({p.enquete.total} {p.enquete.total === 1 ? 'voto' : 'votos'}). Sua opinião conta.</span>
    </div>
  )}
  {podeAgir(p) ? (
    <div class="acoes-card">
      <a class="botao cheio" href={urlProposta(p)}>
        Participar
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="botao contorno icone" href={textoWhatsApp(p)} target="_blank" rel="noopener" aria-label="Mandar no WhatsApp">
        <!-- Ícone do WhatsApp: Simple Icons (CC0). Cor #128C7E (verde do WhatsApp) para contraste suficiente no fundo branco. -->
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#128C7E" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
      </a>
    </div>
  ) : (
    <a class="botao contorno" href={urlProposta(p)}>Ver o que aconteceu</a>
  )}
</article>
